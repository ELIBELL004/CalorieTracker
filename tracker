import java.util.Scanner;
 
public class CampusMealPlanner {

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);


        int menCal = 2500; // Initializing program constants
        int femCal = 2000;

        double breakfastCost = 9.85;
        double lunchCost = 12.75;
        double dinnerCost = 15.50;

        int breakfastCal = 650;
        int lunchCal = 800;
        int dinnerCal = 1000;



        System.out.print("Enter your daily meal budget. ");
        double budget = input.nextDouble();
        while (budget <= 0) {
            System.out.println("Please input budget greater than $0");
            budget = input.nextDouble();    
        }
        
        
        // while loop to ensure valid gender input
        int calGoal = 0;   
        while (calGoal ==0) { 

            System.out.print("Enter your gender, M/F: ");
            String gender = input.next();

            if (gender.equalsIgnoreCase("M")) {

                calGoal = menCal;
                System.out.println("Your daily calorie goal is " + calGoal + " calories.");
        }
            else if (gender.equalsIgnoreCase("F")) {

                calGoal = femCal;
                System.out.println("Your daily calorie goal is " + calGoal + " calories.");    
        }
            else {
                System.out.println("Invalid input. Please enter M or F");
        }
        }


        int totalCal = 0;
        String choice ="";
        boolean finished = false;

        
        while (finished == false) {
            System.out.println("Menu");
            System.out.println("Breakfast: $" + breakfastCost + " " + breakfastCal + " calories");
            System.out.println("Lunch: $" + lunchCost + " " + lunchCal + " calories");
            System.out.println("Dinner: $" + lunchCost + " " + lunchCal + " calories");
            System.out.println("Please input the meals you have eaten today, \"breakfast\", \"lunch\", or \"dinner\" or type \"done\" to exit.");
            choice = input.next();



            if (choice.equalsIgnoreCase("done")){ // Conditional for exiting while loop
                finished = true;
            }
            else if (choice.equalsIgnoreCase("breakfast")) { // Conditional for breakfast input
                if (breakfastCost <= budget) {

                    budget = budget - breakfastCost;
                    totalCal = totalCal + breakfastCal;
                    System.out.println("You have added breakfast");
                    System.out.printf("Remaining budget: $%.2f%n", budget);
                    
                }
                else {
                    System.out.println("Sorry you can not afford breakfast.");
                }
            }
            else if (choice.equalsIgnoreCase("lunch")) { // Conditional for lunch input
                if (lunchCost <= budget) {
                    budget = budget - lunchCost;
                    totalCal = totalCal + lunchCal;
                    System.out.println("You have added lunch");
                    System.out.printf("Remaining budget: $%.2f%n", budget);
                }
                else {
                    System.out.println("Sorry you can not afford lunch.");
                }
            }
            else if (choice.equalsIgnoreCase("dinner")){ // Conditional for dinner input
                if (dinnerCost <= budget) {
                    budget = budget -dinnerCost;
                    totalCal = totalCal + dinnerCal;
                    System.out.println("You have added dinner");
                    System.out.printf("Remaining budget: $%.2f%n", budget);
                }
                else {
                    System.out.println("You can not afford dinner");
                }
            
            System.out.printf("Remaining budget: $%.2f%n", budget); 
            System.out.println("Total calories so far: " + totalCal);
            }
        }

        System.out.println("You have consumed " + totalCal + " calories");
        

        

    }
    }

    
    
    
    
    
    
    
    


    
